+static bool metal_graph_streaming_expert_hotlist_load_file_v2(
+        const char *path,
+        uint32_t    max_entries,
+        uint32_t    layer_count,
+        int32_t     experts[DS4_MAX_LAYER][DS4_MAX_EXPERT],
+        uint32_t    priorities[DS4_MAX_LAYER][DS4_MAX_EXPERT],
+        uint32_t    counts[DS4_MAX_LAYER],
+        bool        seen[DS4_MAX_LAYER][DS4_MAX_EXPERT],
+        uint32_t   *loaded_out) {
+    FILE *fp = fopen(path, "rb");
+    if (!fp) {
+        fprintf(stderr,
+                "ds4: failed to open streaming expert hotlist %s: %s\n",
+                path,
+                strerror(errno));
+        return false;
+    }
+    if (layer_count == 0) layer_count = DS4_N_LAYER;
+    if (layer_count > DS4_MAX_LAYER) layer_count = DS4_MAX_LAYER;
+    uint32_t per_layer_cap = max_entries / layer_count;
+    if (per_layer_cap == 0) per_layer_cap = 1;
+
+    char line[256];
+    uint64_t lineno = 0;
+    uint32_t loaded = 0;
+    uint32_t layer_done = 0;
+    uint32_t current_layer = UINT32_MAX;
+    while (fgets(line, sizeof(line), fp)) {
+        if (loaded >= max_entries || layer_done >= layer_count) break;
+        lineno++;
+        char *p = line;
+        while (*p && isspace((unsigned char)*p)) p++;
+        if (*p == '\0' || *p == '#') continue;
+
+        errno = 0;
+        char *end = NULL;
+        unsigned long layer = strtoul(p, &end, 10);
+        if (end == p || errno != 0) goto bad_line;
+        p = end;
+        while (*p && isspace((unsigned char)*p)) p++;
+
+        errno = 0;
+        unsigned long expert = strtoul(p, &end, 10);
+        if (end == p || errno != 0) goto bad_line;
+        p = end;
+        while (*p && isspace((unsigned char)*p)) p++;
+
+        errno = 0;
+        unsigned long long hits = strtoull(p, &end, 10);
+        if (end == p || errno != 0) goto bad_line;
+        if (hits == 0) continue;
+        if (layer >= layer_count || expert >= DS4_N_EXPERT) continue;
+        if ((uint32_t)layer != current_layer) {
+            current_layer = (uint32_t)layer;
+            if (counts[current_layer] >= per_layer_cap) continue;
+        }
+        if (counts[current_layer] >= per_layer_cap) continue;
+        const uint32_t priority =
+            hits > UINT32_MAX ? UINT32_MAX : (uint32_t)hits;
+        if (!metal_graph_streaming_expert_hotlist_add((uint32_t)layer,
+                                                      (uint32_t)expert,
+                                                      priority,
+                                                      experts,
+                                                      priorities,
+                                                      counts,
+                                                      seen,
+                                                      &loaded)) {
+            goto bad_line;
+        }
+        if (counts[current_layer] == per_layer_cap) layer_done++;
+        continue;
+
+bad_line:
+        fprintf(stderr,
+                "ds4: invalid streaming expert hotlist line %" PRIu64 " in %s\n",
+                lineno,
+                path);
+        fclose(fp);
+        return false;
+    }
+    fclose(fp);
+
+    if (loaded == 0) {
+        fprintf(stderr, "ds4: streaming expert hotlist %s had no usable nonzero entries\n", path);
+    }
+    *loaded_out = loaded;
+    return true;
+}
