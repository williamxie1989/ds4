+/*
+ * Hotlist v2 (R2a/M3-1): per-layer ranked candidates.  The v1 loader treats
+ * the file as one global ranked list and stops at max_entries, which gives
+ * layer 0 count/DS4_N_LAYER slots — far below the per-layer cache share.
+ * The v2 header ("# ds4 expert hotlist v2 layers N") declares the per-layer
+ * rank; entries are consumed layer-major and per-layer rank-fair, so a
+ * truncated load keeps every layer's top ranks.  Each layer gets at most its
+ * fair share of the preload budget: max(1, preload/layer_count), which
+ * protects K = share/cache_slots of the resident cache (protect bit).  v1
+ * files (no v2 header) keep the exact pre-R2a global behavior.
+ */
+static bool metal_graph_streaming_expert_hotlist_v2_probe(FILE *fp,
+                                                          uint32_t *per_layer) {
+    char line[256];
+    const long pos = ftell(fp);
+    if (pos < 0) return false;
+    while (fgets(line, sizeof(line), fp)) {
+        char *p = line;
+        while (*p && isspace((unsigned char)*p)) p++;
+        if (*p == '\0' || *p != '#') break;
+        if (strstr(line, "# ds4 expert hotlist v2 layers ")) {
+            const char *v = strstr(line, "layers ") + strlen("layers ");
+            errno = 0;
+            const unsigned long layers = strtoul(v, NULL, 10);
+            if (errno != 0 || layers == 0 || layers > DS4_MAX_LAYER) {
+                fseek(fp, pos, SEEK_SET);
+                return false;
+            }
+            *per_layer = (uint32_t)layers;
+            fseek(fp, pos, SEEK_SET);
+            return true;
+        }
+    }
+    fseek(fp, pos, SEEK_SET);
+    return false;
+}
