+    uint64_t hits_before = ds4_gpu_stream_expert_cache_hit_count();
+    ok = ok && ds4_gpu_begin_commands() &&
+         ds4_gpu_stream_expert_cache_seed_experts(&table,
+                                                  probe_ids,
+                                                  NULL,
+                                                  2) &&
+         ds4_gpu_end_commands();
+    const uint64_t hits_on = ds4_gpu_stream_expert_cache_hit_count() -
+                             hits_before;
+    if (hits_on != 2u) {
+        fprintf(stderr,
+                "Metal SSD protect: probes should have survived (peek hits=%llu, want 2)\n",
+                (unsigned long long)hits_on);
+        ok = 0;
+    }
+
+    /* Arm 2 — protect OFF: identical pressure reclaims the probes and the
+     * reseed peeks miss.  Feeding the arm-1 map while inactive must CLEAR
+     * the bits (kill-switch semantics). */
+    unsetenv("DS4_V41_HOTLIST_PROTECT");
+    ok = ok && !ds4_gpu_stream_expert_cache_hotlist_protect_active();
+    ds4_gpu_set_streaming_expert_cache_budget(8);
+    ds4_gpu_stream_expert_cache_reset_route_hotness();
+    /* Feeding the arm-1 map while inactive must CLEAR the bits (kill-switch
+     * semantics): the same pressure must now evict the probes. */
+    ds4_gpu_stream_expert_cache_set_protected_experts(protected_map);
+    ok = ok && ds4_gpu_begin_commands() &&
+         ds4_gpu_stream_expert_cache_seed_experts(&table,
+                                                  probe_ids,
+                                                  NULL,
+                                                  2) &&
+         ds4_gpu_stream_expert_cache_seed_experts(&table, rest, NULL, 8) &&
+         ds4_gpu_end_commands();
+    ok = ok && ds4_gpu_stream_expert_cache_current_count() == 8u;
+    hits_before = ds4_gpu_stream_expert_cache_hit_count();
+    ok = ok && ds4_gpu_begin_commands() &&
+         ds4_gpu_stream_expert_cache_seed_experts(&table,
+                                                  probe_ids,
+                                                  NULL,
+                                                  2) &&
+         ds4_gpu_end_commands();
+    const uint64_t hits_off = ds4_gpu_stream_expert_cache_hit_count() -
+                              hits_before;
+    if (hits_off != 0u) {
+        fprintf(stderr,
+                "Metal SSD protect-off: probes should have been evicted (peek hits=%llu, want 0)\n",
+                (unsigned long long)hits_off);
+        ok = 0;
+    }
+    ds4_gpu_set_streaming_expert_cache_budget(E);
+    ds4_gpu_stream_expert_cache_set_protected_experts(NULL);
+    if (ok) {
+        fprintf(stderr, "Metal SSD hotlist protect eviction order: PASS\n");
+    }
+    return ok;
+}
