+/* Idle-window prewarm (R2a/M3-2): re-run the hotlist seed between requests.
+ * The seed path skips work when the cache is already at the preload target,
+ * so a warm server pays one pass over the (layer, expert) counters.  Peeking
+ * an already-resident expert renews its last_used stamp; only evicted
+ * candidates cause preads.  Seeding is idempotent: same file, same budgets,
+ * same expert bytes — no output change (bytes only move, never mutate). */
+#ifndef DS4_NO_GPU
+bool ds4_engine_prewarm_streaming_hotlist(ds4_engine *e) {
+    if (!e || !e->ssd_streaming || e->backend != DS4_BACKEND_METAL) return false;
+    if (DS4_MODEL_FAMILY != DS4_MODEL_FAMILY_DEEPSEEK41) return false;
+    if (!metal_graph_streaming_expert_hotlist_protect_runtime_active()) return false;
+    /* The seed path gates on graph fields (ssd_streaming/cold/preload), and
+     * preload_count(NULL, ...) is 0 — a NULL graph silently no-ops.  Build a
+     * minimal seed graph from engine-owned streaming state instead (same
+     * pattern as the GLM seed-before-prefill path); with no explicit preload
+     * count the auto cap (DS4_METAL_STREAMING_EXPERT_AUTO_PRELOAD_CAP,
+     * default 4096) sizes the hot seed. */
+    ds4_gpu_graph seed_graph;
+    memset(&seed_graph, 0, sizeof(seed_graph));
+    seed_graph.ssd_streaming = true;
+    seed_graph.ssd_streaming_cold = false;
+    ds4_gpu_stream_expert_cache_note_service_thread();
+    return metal_graph_seed_streaming_expert_cache_from_hotlist(&seed_graph,
+                                                                &e->model,
+                                                                &e->weights);
+}
+#else
+bool ds4_engine_prewarm_streaming_hotlist(ds4_engine *e) {
+    (void)e;
+    return false;
+}
+#endif
